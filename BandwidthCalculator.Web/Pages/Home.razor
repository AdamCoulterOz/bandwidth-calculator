@page "/"

<PageTitle>Bandwidth Calculator</PageTitle>

<header class="app-header">
    <div class="app-header-inner">
        <img class="brand-mark" src="favicon.svg" alt="" aria-hidden="true" />
        <div class="app-header-copy">
            <h1>Bandwidth Calculator</h1>
            <p>Display timing, bandwidth and link compatibility</p>
        </div>
        <button type="button" class="button button-secondary header-reset" @onclick="Reset">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 4v6h6M20 20v-6h-6" />
                <path d="M19 9a8 8 0 0 0-13.5-3L4 10m16 4-1.5 4A8 8 0 0 1 5 15" />
            </svg>
            Reset
        </button>
    </div>
</header>

<div class="app-shell">
    <main class="workspace">
        <section class="configuration-panel" aria-label="Configuration">
            <CalculatorForm @key="_form"
                            Model="_form"
                            ErrorMessage="@_errorMessage"
                            OnCalculate="Calculate"
                            OnInvalid="InvalidateResult" />
        </section>

        <section class="results-panel" aria-live="polite" aria-busy="false">
            @if (_result is not null)
            {
                <BandwidthSummary Bandwidth="_result.Bandwidth" />

                <section class="result-section compatibility-section" aria-label="Link compatibility">
                    <CompatibilityGroup Title="DisplayPort" Evaluations="_result.DisplayPort" />
                    <CompatibilityGroup Title="HDMI" Evaluations="_result.Hdmi" />
                    <CompatibilityGroup Title="USB-C"
                                        TooltipTitle="USB-C DisplayPort Alt Mode"
                                        Description="USB-C DisplayPort Alt Mode carries DisplayPort video over a USB-C connector. Its available DisplayPort lane allocation and link rate depend on the negotiated Alt Mode configuration."
                                        Evaluations="_result.DisplayPortAltModeOnUsbC" />
                </section>

                <TimingDetails Timing="_result.Timing" />
            }
            else
            {
                <div class="empty-results">
                    <svg viewBox="0 0 32 32" aria-hidden="true">
                        <path d="M8 5h16a3 3 0 0 1 3 3v16a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Z" />
                        <path d="M10 11h12M10 16h4m4 0h4m-12 5h4m4 0h4" />
                    </svg>
                    <h2>Configuration needs attention</h2>
                    <p>Correct the configuration error to update the results.</p>
                </div>
            }
        </section>
    </main>
</div>

<footer class="site-footer">
    <div class="site-footer-inner">
        <a class="site-home-link" href="https://adamcoulteroz.github.io/" aria-label="Back to Adam Coulter's projects and tools">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5m6-6-6 6 6 6" />
            </svg>
            Adam Coulter — Projects and tools
        </a>
    </div>
</footer>

@code {
    private CalculatorFormModel _form = new();
    private CalculationResult? _result;
    private string? _errorMessage;

    protected override void OnInitialized() => Calculate();

    private void Calculate()
    {
        try
        {
            CalculationInput input = _form.ToCalculationInput();
            _result = _form.UseExactCapabilities
                ? global::BandwidthCalculator.BandwidthCalculator.Calculate(input, _form.ToInterfaceConfiguration())
                : global::BandwidthCalculator.BandwidthCalculator.Calculate(input);
            _errorMessage = null;
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or OverflowException)
        {
            _result = null;
            _errorMessage = exception.Message;
        }
    }

    private void Reset()
    {
        _form = new CalculatorFormModel();
        Calculate();
    }

    private void InvalidateResult()
    {
        _result = null;
        _errorMessage = null;
    }
}
