    private bool TryResizeToPixelDensity(double pixelsPerInch, out int width, out int height)
    {
        double ratioWidth = Model.AspectRatioWidth;
        double ratioHeight = Model.AspectRatioHeight;
        double ratioDiagonal = Math.Sqrt((ratioWidth * ratioWidth) + (ratioHeight * ratioHeight));
        double pixelDiagonal = GetDisplayDiagonal().Inches * pixelsPerInch;

        bool widthIsValid = TryRoundPixelDimension(pixelDiagonal * ratioWidth / ratioDiagonal, out width);
        bool heightIsValid = TryRoundPixelDimension(pixelDiagonal * ratioHeight / ratioDiagonal, out height);
        return widthIsValid && heightIsValid;
    }

    private static bool TryRoundPixelDimension(double value, out int result)
    {
        if (!double.IsFinite(value) || value < 1d || value > int.MaxValue)
        {
            result = default;
            return false;
        }

        result = (int)Math.Round(value, MidpointRounding.AwayFromZero);
        return true;
    }

    private void SetPixelDensityError(string? message)
    {
        _pixelDensityError = message;
        SetInputValidity(PixelDensityInput, message is null);
    }

    private void RefreshPixelDensityText()
    {
        _pixelDensityText = double.IsFinite(Model.PixelsPerInch)
            ? Math.Round(Model.PixelsPerInch, 0, MidpointRounding.AwayFromZero).ToString("0", CultureInfo.InvariantCulture)
            : string.Empty;
        SetPixelDensityError(null);
    }

    private void SetInputValidity(string field, bool isValid)
    {
        if (isValid)
        {
            _invalidInputFields.Remove(field);
            return;
        }

        _invalidInputFields.Add(field);
    }

    private void ClearInactiveInputErrors()
    {
        if (Model.Timing is not (TimingStandard.Dmt or TimingStandard.Cta861))
        {
            _invalidInputFields.Remove(nameof(CalculatorFormModel.StandardTimingId));
        }

        if (Model.Timing != TimingStandard.CvtReducedBlankingV3)
        {
            _invalidInputFields.Remove(nameof(CalculatorFormModel.RbV3HorizontalBlankPixels));
            _invalidInputFields.Remove(nameof(CalculatorFormModel.RbV3MinimumVerticalBlankMicroseconds));
        }
    }

    private static bool TryParseInt(ChangeEventArgs args, out int value) =>
        int.TryParse(
            args.Value?.ToString(),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out value);

    private void DeriveAspectRatio()
    {
        if (Model.Width <= 0 || Model.Height <= 0)
        {
            return;
        }

        int divisor = GreatestCommonDivisor(Model.Width, Model.Height);
        Model.AspectRatioWidth = Model.Width / divisor;
        Model.AspectRatioHeight = Model.Height / divisor;
    }

    private void MatchResolutionPreset() =>
        Model.ResolutionPresetId = DisplayResolutionPreset.Match(Model.Width, Model.Height);

    private static int GreatestCommonDivisor(int left, int right)
    {
        while (right != 0)
        {
            (left, right) = (right, left % right);
        }

        return left;
    }

    private static bool TryScaleDimension(int fixedDimension, int ratioPart, int fixedRatioPart, out int result)
    {
        double scaled = (double)fixedDimension * ratioPart / fixedRatioPart;
        if (!double.IsFinite(scaled) || scaled < 1d || scaled > int.MaxValue)
        {
            result = default;
            return false;
        }

        result = (int)Math.Round(scaled, MidpointRounding.AwayFromZero);
        return true;
    }
}
