    private void ToggleAspectRatioLock() => Model.LockAspectRatio = !Model.LockAspectRatio;

    private string PixelDensityText => _pixelDensityText;

    private async Task UpdateDisplayDiagonalAsync(ChangeEventArgs args)
    {
        bool parsed = double.TryParse(
            args.Value?.ToString(),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out double value);
        SetInputValidity(nameof(CalculatorFormModel.DisplayDiagonal), parsed);
        if (parsed)
        {
            Model.DisplayDiagonal = value;
            RefreshPixelDensityText();
        }

        await RecalculateAsync();
    }

    private async Task UpdatePixelDensityAsync(ChangeEventArgs args)
    {
        _pixelDensityText = args.Value?.ToString() ?? string.Empty;
        bool parsed = double.TryParse(
            _pixelDensityText,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out double pixelsPerInch);

        if (!parsed || !double.IsFinite(pixelsPerInch) || pixelsPerInch <= 0d)
        {
            SetPixelDensityError("Density must be greater than zero.");
            await RecalculateAsync();
            return;
        }

        pixelsPerInch = Math.Round(pixelsPerInch, 0, MidpointRounding.AwayFromZero);
        _pixelDensityText = pixelsPerInch.ToString("0", CultureInfo.InvariantCulture);

        if (!TryResizeToPixelDensity(pixelsPerInch, out int width, out int height))
        {
            SetPixelDensityError("Density is outside the supported pixel-dimension range.");
            await RecalculateAsync();
            return;
        }

        Model.Width = width;
        Model.Height = height;
        MatchResolutionPreset();
        SetPixelDensityError(null);
        await RecalculateAsync();
    }

    private void FinalizePixelDensity(ChangeEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_pixelDensityError))
        {
            RefreshPixelDensityText();
        }
    }

    private async Task UpdateDisplayDiagonalUnitAsync(DisplayDiagonalUnit unit)
    {
        if (unit == Model.DisplayDiagonalUnit)
        {
            await RecalculateAsync();
            return;
        }

        if (double.IsFinite(Model.DisplayDiagonal) && Model.DisplayDiagonal > 0d)
        {
            Length diagonal = GetDisplayDiagonal();
            Model.DisplayDiagonalUnit = unit;
            SetDisplayDiagonal(diagonal);
            await RecalculateAsync();
            return;
        }

        Model.DisplayDiagonalUnit = unit;
        await RecalculateAsync();
    }

    private Length GetDisplayDiagonal() => Model.DisplayDiagonalUnit switch
    {
        DisplayDiagonalUnit.Inches => Length.FromInches(Model.DisplayDiagonal),
        DisplayDiagonalUnit.Centimeters => Length.FromCentimeters(Model.DisplayDiagonal),
        _ => throw new InvalidOperationException($"Unsupported display diagonal unit {Model.DisplayDiagonalUnit}."),
    };

    private void SetDisplayDiagonal(Length diagonal)
    {
        Model.DisplayDiagonal = Model.DisplayDiagonalUnit switch
        {
            DisplayDiagonalUnit.Inches => diagonal.Inches,
            DisplayDiagonalUnit.Centimeters => diagonal.Centimeters,
            _ => throw new InvalidOperationException($"Unsupported display diagonal unit {Model.DisplayDiagonalUnit}."),
        };
    }

